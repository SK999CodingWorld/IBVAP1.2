# Local Vite requests use the /api proxy configured in vite.config.ts.
VITE_API_BASE_URL=/api/v1
VITE_API_TIMEOUT_MS=20000
VITE_DEMO_MODE=false
VITE_DEV_API_TARGET=http://127.0.0.1:8001

# Production falls back to the project's Render API URL when this variable is unset.
# Override VITE_API_BASE_URL in Vercel if you use another backend host:
# https://YOUR-RENDER-SERVICE.onrender.com/api/v1
