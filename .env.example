# ==============================================================================
# IBVAP Environment Variables & Secrets Configuration Template
# ==============================================================================
# Copy this file to '.env' in your local environment.
# Production values belong in the API host's environment/secret manager.

# --- Environment & Host ---
ENVIRONMENT=development                # development | production | test
HOST=0.0.0.0
PORT=8001

# --- Security & JWT Authentication ---
# In production, must be at least 32 characters generated securely:
# e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=supersecretkey-change-in-production-ibvap-safe-dev-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
WEBHOOK_SECRET=ibvap_webhook_signature_secret_32bytes_change_in_prod

# --- Database (Async SQLAlchemy) ---
# Local SQLite default:
DATABASE_URL=sqlite+aiosqlite:///./ibvap.db
# Supabase Postgres: copy the connection string from Project > Connect.
# Prefer the Transaction pooler (port 6543) for externally hosted API instances.
# Example: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# The app normalizes postgres:// and postgresql:// to SQLAlchemy's asyncpg driver.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres
DB_SSL=false                            # Set true in production; Supabase requires TLS.

# --- Connection Pool Tuning (PostgreSQL only) ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# --- Redis & Distributed Caching ---
# Optional: falls back to ultra-fast in-memory TTL cache if Redis is unavailable
REDIS_URL=redis://localhost:6379

# --- CORS & Network Protection ---
# JSON list of allowed frontend origins in production. Never use * with credentials.
# Example: ["https://your-project.vercel.app", "https://app.example.com"]
CORS_ORIGINS=["*"]
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_SIZE_BYTES=10485760

# --- Feature Flags ---
DEMO_MODE=true
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=admin123
ENABLE_KEY_HEALTH_CHECK=false
ENABLE_BACKGROUND_WORKERS=true        # Disable on API web instances; deploy workers separately.
AI_BACKEND=mock
EDGE_NODE_ID=EDGE-001
